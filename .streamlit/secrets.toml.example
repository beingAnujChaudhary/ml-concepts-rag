# Streamlit Cloud Secrets — copy these values into:
# App Settings → Secrets on share.streamlit.io
#
# At minimum you need GROQ_API_KEY (free) and PINECONE_API_KEY (free tier).

# === LLM Provider (pick at least one) ===
# Free tier: https://console.groq.com
GROQ_API_KEY = "your_groq_api_key_here"
GROQ_MODEL = "llama-3.1-8b-instant"

# Optional: https://platform.openai.com (paid)
# OPENAI_API_KEY = "sk-proj-..."
# OPENAI_MODEL = "gpt-4o-mini"

# === Vector Database ===
# Free tier: https://app.pinecone.io
PINECONE_API_KEY = "your_pinecone_api_key_here"

# === PostgreSQL for monitoring (optional) ===
# Free tier: https://supabase.com
# DATABASE_URL = "postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"
