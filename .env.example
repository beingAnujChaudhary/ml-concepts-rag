# Copy this file to .env and set at least one LLM provider key.
# The app tries OpenAI first; if it fails, it falls back to Groq.
# Never commit the populated .env file.

# OpenAI (optional) — requires billing at platform.openai.com
# OPENAI_API_KEY=sk-proj-your_key_here
# OPENAI_MODEL=gpt-4o-mini
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant

# Pinecone Vector Database (Free tier at pinecone.io)
PINECONE_API_KEY=replace-with-your-pinecone-key

# Supabase PostgreSQL (Free tier at supabase.com)
# Format: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres
DATABASE_URL=replace-with-your-supabase-connection-string
